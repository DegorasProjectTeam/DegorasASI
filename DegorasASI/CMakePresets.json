{
  "version": 10,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "devsystem",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "$env{DEVSYSTEM_BUILDTREES}/DegorasASI/${presetName}",
      "cacheVariables": {
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_FIND_PACKAGE_PREFER_CONFIG": "ON"
      }
    },

    {
      "name": "mingw",
      "hidden": true,
      "inherits": "devsystem",
      "condition": {
        "type": "allOf",
        "conditions": [
          { "type": "equals",    "lhs": "${hostSystemName}",              "rhs": "Windows" },
          { "type": "notEquals", "lhs": "$env{DEVSYSTEM_BUILDTREES}",     "rhs": "" },
          { "type": "notEquals", "lhs": "$env{DEVSYSTEM_DEPLOYS}",        "rhs": "" },
          { "type": "notEquals", "lhs": "$env{MINGW_ROOT}",               "rhs": "" },
          { "type": "notEquals", "lhs": "$env{VCPKG_DEFAULT_TRIPLET}",    "rhs": "" }
        ]
      },
      "cmakeExecutable": "$env{MINGW_ROOT}/bin/cmake.exe",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/dp_windows_mingw.cmake"
      },
      "environment": {
        "PATH": "$env{MINGW_ROOT}/bin;$penv{PATH}"
      }
    },

    {
      "name": "mingw-dynamic",
      "hidden": true,
      "inherits": "mingw",
      "installDir": "$env{DEVSYSTEM_DEPLOYS}/DegorasASI/$env{VCPKG_DEFAULT_TRIPLET}",
      "cacheVariables": { "DEGORASASI_BUILD_SHARED": "ON" }
    },

    {
      "name": "mingw-static",
      "hidden": true,
      "inherits": "mingw",
      "installDir": "$env{DEVSYSTEM_DEPLOYS}/DegorasASI/x64-mingw-ucrt-static-release",
      "cacheVariables": { "DEGORASASI_BUILD_SHARED": "OFF" }
    },

    {
      "name": "mingw-dynamic-deb",
      "displayName": "MinGW Shared Debug",
      "inherits": "mingw-dynamic",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "mingw-dynamic-rel",
      "displayName": "MinGW Shared Release",
      "inherits": "mingw-dynamic",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mingw-static-deb",
      "displayName": "MinGW Static Debug",
      "inherits": "mingw-static",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "mingw-static-rel",
      "displayName": "MinGW Static Release",
      "inherits": "mingw-static",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "qtcreator-mingw",
      "hidden": true,
      "inherits": "mingw-dynamic",
      "vendor": {
        "qt.io/QtCreator/1.0": {
          "AskBeforePresetsReload": false,
          "AskReConfigureInitialParams": false,
          "AutorunCMake": false,
          "PackageManagerAutoSetup": false,
          "ShowAdvancedOptionsByDefault": true,
          "ShowSourceSubfolders": true,
          "UseJunctionsForSourceAndBuildDirectories": true,
          "debugger": {
            "DisplayName": "DP-UCRT64-GDB",
            "Abis": [ "x86-windows-msys-pe-64bit" ],
            "Binary": "$env{MINGW_ROOT}/bin/gdb.exe",
            "EngineType": 1,
            "Version": "17.2"
          }
        }
      }
    },

    {
      "name": "qtcreator-mingw-deb",
      "displayName": "QtCreator: MinGW Shared Debug",
      "inherits": "qtcreator-mingw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "qtcreator-mingw-rel",
      "displayName": "QtCreator: MinGW Shared Release",
      "inherits": "qtcreator-mingw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "unix",
      "hidden": true,
      "inherits": "devsystem",
      "installDir": "$env{DEVSYSTEM_DEPLOYS}/DegorasASI/$env{VCPKG_DEFAULT_TRIPLET}",
      "condition": {
        "type": "allOf",
        "conditions": [
          { "type": "notEquals", "lhs": "${hostSystemName}",           "rhs": "Windows" },
          { "type": "notEquals", "lhs": "$env{DEVSYSTEM_BUILDTREES}",  "rhs": "" },
          { "type": "notEquals", "lhs": "$env{DEVSYSTEM_DEPLOYS}",     "rhs": "" },
          { "type": "notEquals", "lhs": "$env{VCPKG_DEFAULT_TRIPLET}", "rhs": "" }
        ]
      },
      "cacheVariables": { "DEGORASASI_BUILD_SHARED": "ON" }
    },
    {
      "name": "unix-dynamic-deb",
      "displayName": "Unix Shared Debug (host toolchain)",
      "inherits": "unix",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "unix-dynamic-rel",
      "displayName": "Unix Shared Release (host toolchain)",
      "inherits": "unix",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],

  "buildPresets": [
    { "name": "mingw-dynamic-deb",   "configurePreset": "mingw-dynamic-deb",   "jobs": 0, "verbose": true },
    { "name": "mingw-dynamic-rel",   "configurePreset": "mingw-dynamic-rel",   "jobs": 0, "verbose": true },
    { "name": "mingw-static-deb",    "configurePreset": "mingw-static-deb",    "jobs": 0, "verbose": true },
    { "name": "mingw-static-rel",    "configurePreset": "mingw-static-rel",    "jobs": 0, "verbose": true },
    { "name": "qtcreator-mingw-deb", "configurePreset": "qtcreator-mingw-deb", "jobs": 0 },
    { "name": "qtcreator-mingw-rel", "configurePreset": "qtcreator-mingw-rel", "jobs": 0 },
    { "name": "unix-dynamic-deb",    "configurePreset": "unix-dynamic-deb",    "jobs": 0, "verbose": true },
    { "name": "unix-dynamic-rel",    "configurePreset": "unix-dynamic-rel",    "jobs": 0, "verbose": true }
  ],

  "testPresets": [
    { "name": "mingw-dynamic-deb",   "configurePreset": "mingw-dynamic-deb",   "output": { "outputOnFailure": true } },
    { "name": "mingw-dynamic-rel",   "configurePreset": "mingw-dynamic-rel",   "output": { "outputOnFailure": true } },
    { "name": "qtcreator-mingw-deb", "configurePreset": "qtcreator-mingw-deb", "output": { "outputOnFailure": true } },
    { "name": "unix-dynamic-deb",    "configurePreset": "unix-dynamic-deb",    "output": { "outputOnFailure": true } },
    { "name": "unix-dynamic-rel",    "configurePreset": "unix-dynamic-rel",    "output": { "outputOnFailure": true } }
  ],

  "workflowPresets": [
    {
      "name": "mingw-dynamic-deb",
      "displayName": "Configure, build and test: MinGW Shared Debug",
      "steps": [
        { "type": "configure", "name": "mingw-dynamic-deb" },
        { "type": "build",     "name": "mingw-dynamic-deb" },
        { "type": "test",      "name": "mingw-dynamic-deb" }
      ]
    },
    {
      "name": "mingw-dynamic-rel",
      "displayName": "Configure, build and test: MinGW Shared Release",
      "steps": [
        { "type": "configure", "name": "mingw-dynamic-rel" },
        { "type": "build",     "name": "mingw-dynamic-rel" },
        { "type": "test",      "name": "mingw-dynamic-rel" }
      ]
    }
  ]
}
