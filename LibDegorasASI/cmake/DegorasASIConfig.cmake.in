@PACKAGE_INIT@

# CMake package configuration for DegorasASI (find_package(DegorasASI CONFIG)).
# Provides the imported target:  Degoras::ASI

include(CMakeFindDependencyMacro)

# Make the Find modules shipped alongside this config (e.g. FindASICamera.cmake) discoverable.
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# The status poller's std::thread usage puts Threads in the PUBLIC link interface.
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)

# For a STATIC build the private ZWO dependency is part of the link interface and must be re-located here; for a
# SHARED build it is sealed inside the DLL and this line is empty.
@LA_ASI_FIND_DEPENDENCY@

include("${CMAKE_CURRENT_LIST_DIR}/DegorasASITargets.cmake")

check_required_components(DegorasASI)
